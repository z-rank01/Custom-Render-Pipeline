#pragma kernel VisualizeOverdraw

RWTexture2D<float> _OverdrawVisualizationTexture_R;
RWTexture2D<float> _OverdrawVisualizationTexture_G;
RWTexture2D<float> _OverdrawVisualizationTexture_B;
RWTexture2D<float> _OverdrawVisualizationTexture_A;
RWStructuredBuffer<int> _OverdrawCounters;

uint _ComputeScreenWidth;
uint _ComputeScreenHeight;
uint _MaxOverdrawThreshold;
float4 _MinOverdrawColor;
float4 _MaxOverdrawColor;

float3 GetLinearHeatmapColor(int overdrawCount, uint maxThreshold)
{
    if (overdrawCount <= 1)
        return _MinOverdrawColor.rgb;
    
    // 计算归一化的overdraw值 (0到1之间)
    float normalizedCount = saturate((float)overdrawCount / (float)maxThreshold);
    
    // 在最小颜色和最大颜色之间进行线性插值
    float3 color = lerp(_MinOverdrawColor.rgb, _MaxOverdrawColor.rgb, normalizedCount);
    return color;
}

[numthreads(8,8,1)]
void VisualizeOverdraw(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ComputeScreenWidth || id.y >= _ComputeScreenHeight)
        return;

    uint index = id.y * _ComputeScreenWidth + id.x;
    int overdrawCount = _OverdrawCounters[index];
    
    float3 heatmapColor = GetLinearHeatmapColor(overdrawCount, _MaxOverdrawThreshold);
    
    // 分别写入四张单通道纹理
    _OverdrawVisualizationTexture_R[id.xy] = heatmapColor.r;
    _OverdrawVisualizationTexture_G[id.xy] = heatmapColor.g;
    _OverdrawVisualizationTexture_B[id.xy] = heatmapColor.b;
    _OverdrawVisualizationTexture_A[id.xy] = 1.0;
}
