#pragma kernel VisualizeOverdraw

RWTexture2D<float4> _OverdrawVisualizationTexture;
RWStructuredBuffer<uint> _OverdrawCounters;

uint _ScreenWidth;
uint _ScreenHeight;
uint _MaxOverdrawThreshold;
float4 _MinOverdrawColor;
float4 _MaxOverdrawColor;

float3 GetLinearHeatmapColor(uint overdrawCount, uint maxThreshold)
{
    if (overdrawCount == 0)
        return _MinOverdrawColor.rgb;
    
    // 计算归一化的overdraw值 (0到1之间)
    float normalizedCount = saturate((float)overdrawCount / (float)maxThreshold);
    
    // 在最小颜色和最大颜色之间进行线性插值
    float3 color = lerp(_MinOverdrawColor.rgb, _MaxOverdrawColor.rgb, normalizedCount);
    return color;
}

[numthreads(8,8,1)]
void VisualizeOverdraw(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ScreenWidth || id.y >= _ScreenHeight)
        return;

    uint index = id.y * _ScreenWidth + id.x;
    uint overdrawCount = _OverdrawCounters[index];

    // // 强制测试：屏幕中心区域显示为红色
    // if (abs((int)id.x - (int)(_ScreenWidth / 2)) < 100 && 
    //     abs((int)id.y - (int)(_ScreenHeight / 2)) < 100)
    // {
    //     _OverdrawVisualizationTexture[id.xy] = float4(1, 0, 0, 1);
    //     return;
    // }

    // // Compute Shader 强制写入：左上角绿色
    // if (id.x < 100 && id.y < 100)
    // {
    //     InterlockedAdd(_OverdrawCounters[index], 5);
    //     _OverdrawVisualizationTexture[id.xy] = float4(0, 1, 0, 1); // 绿色
    //     return;
    // }
    
    // // Fragment Shader 测试区域：右上角蓝色（如果有数据）
    // if (id.x > (_ScreenWidth - 100) && id.y < 100 && overdrawCount > 0)
    // {
    //     _OverdrawVisualizationTexture[id.xy] = float4(0, 0, 1, 1); // 蓝色
    //     return;
    // }
    
    // 显示真实的 overdraw 数据
    // if (overdrawCount > 0)
    // {
    //     // 如果有真实的 overdraw 数据，显示为蓝色
    //     _OverdrawVisualizationTexture[id.xy] = float4(0, 0, 1, 1);
    //     return;
    // }
    
    // 使用线性插值颜色
    float3 heatmapColor = GetLinearHeatmapColor(overdrawCount, _MaxOverdrawThreshold);
    _OverdrawVisualizationTexture[id.xy] = float4(heatmapColor, 1.0);
}
